# Django
DJANGO_SECRET_KEY=change-me-for-any-non-local-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
# Show visibly synthetic test stories. Defaults to true in dev; always false in prod.
ALLOW_SYNTHETIC=true
# Demo only: serve single-source proverbs (the africanproverbs.com demo corpus).
# Must be disclosed in the submission. See docs/proverbs/DEMO_CORPUS.md.
DEMO_ALLOW_SINGLE_SOURCE_PROVERBS=false

# PostgreSQL
POSTGRES_DB=greeo
POSTGRES_USER=greeo
POSTGRES_PASSWORD=greeo-local-only
# Used by Django commands run from your host machine. Compose overrides this
# with its internal `postgres` hostname for containers.
DATABASE_URL=postgresql://greeo:greeo-local-only@127.0.0.1:5433/greeo

# Redis and Celery
# Used by host commands. Compose overrides this with the internal `redis` hostname.
REDIS_URL=redis://127.0.0.1:6380/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

# RSS ingestion. Set this to a monitored contact address before enabling a real feed.
GREEO_CONTACT_EMAIL=local@example.invalid
NEWS_HTTP_TIMEOUT_SECONDS=10
NEWS_MAX_5XX_RETRIES=2
NEWS_CIRCUIT_OPEN_MINUTES=60
NEWS_DOMAIN_LOCK_SECONDS=60
# Open a feed's circuit after this many failures in a row (403/429 open it at once).
NEWS_MAX_CONSECUTIVE_FAILURES=5

# LLM gateway. Mock is deterministic and makes no network requests. A Bedrock
# deployment can override the shared model or a single prompt's model with
# LLM_<PROMPT_NAME_UPPER>_MODEL_ID (for example LLM_WRITE_TELLING_MODEL_ID).
LLM_BACKEND=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=30
LLM_PROVIDER_RETRIES=2
LLM_MAX_CALLS_PER_RUN=300
LLM_DAILY_TOKEN_BUDGET=500000
LLM_INPUT_PRICE_PER_MILLION_USD=0
LLM_OUTPUT_PRICE_PER_MILLION_USD=0
