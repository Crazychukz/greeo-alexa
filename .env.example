# Django
DJANGO_SECRET_KEY=change-me-for-any-non-local-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
# Show visibly synthetic test stories. Defaults to true in dev; always false in prod.
ALLOW_SYNTHETIC=true
# Demo only: serve single-source proverbs (the africanproverbs.com demo corpus).
# Must be disclosed in the submission. See docs/proverbs/DEMO_CORPUS.md.
DEMO_ALLOW_SINGLE_SOURCE_PROVERBS=false

# PostgreSQL
POSTGRES_DB=greeo
POSTGRES_USER=greeo
POSTGRES_PASSWORD=greeo-local-only
# Used by Django commands run from your host machine. Compose overrides this
# with its internal `postgres` hostname for containers.
DATABASE_URL=postgresql://greeo:greeo-local-only@127.0.0.1:5433/greeo

# Redis and Celery
# Used by host commands. Compose overrides this with the internal `redis` hostname.
REDIS_URL=redis://127.0.0.1:6380/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

# RSS ingestion. Set this to a monitored contact address before enabling a real feed.
GREEO_CONTACT_EMAIL=local@example.invalid
NEWS_HTTP_TIMEOUT_SECONDS=10
NEWS_MAX_5XX_RETRIES=2
NEWS_CIRCUIT_OPEN_MINUTES=60
NEWS_DOMAIN_LOCK_SECONDS=60
# Open a feed's circuit after this many failures in a row (403/429 open it at once).
NEWS_MAX_CONSECUTIVE_FAILURES=5

# MCP server. Compose binds it to 0.0.0.0 inside the container but publishes it on
# 127.0.0.1 only. Origins and hosts are the DNS-rebinding allowlists.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Trust the X-Greeo-User development header. Only allowed when DJANGO_DEBUG is true;
# the MCP server refuses to start otherwise. Defaults to the value of DJANGO_DEBUG.
MCP_ALLOW_DEV_IDENTITY=true
# Requests per minute per token (or per client address for guests). 0 turns it off.
MCP_RATE_LIMIT_PER_MINUTE=240
LOG_LEVEL=INFO
# Source cards omit article links by default (Alexa+ payload guidance).
INCLUDE_SOURCE_URLS=false

# Simulator host API. Compose points it at the mcp service.
SIMULATOR_MCP_URL=http://127.0.0.1:8001/mcp
SIMULATOR_MAX_TOOL_ITERATIONS=4
SIMULATOR_SESSION_SECONDS=1800
# Front-end origins allowed to call /api/simulator/ from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# Simulator speech: mock (browser speech) or polly. Choose a Polly voice available for
# POLLY_ENGINE in your AWS_REGION; pacing markup uses rate and pauses only.
SPEECH_BACKEND=mock
POLLY_VOICE_ID=Ayanda
POLLY_ENGINE=neural
SPEECH_RETRIES=2
SPEECH_CACHE_SECONDS=86400

# LLM gateway. Mock is deterministic and makes no network requests. A Bedrock
# deployment can override the shared model or a single prompt's model with
# LLM_<PROMPT_NAME_UPPER>_MODEL_ID (for example LLM_WRITE_TELLING_MODEL_ID).
# LLM_<PROMPT_NAME_UPPER>_TEMPERATURE does the same for temperature: 0 by default,
# 0.6 for write_telling so tales have some freedom of phrase.
# Tried on live BBC stories (2026-10-01): Kimi K2.5 tells the best tales; Qwen3 235B
# is accurate and cheap for facts and proverb choice. Nova Lite cannot weave proverbs.
# LLM_WRITE_TELLING_MODEL_ID=moonshotai.kimi-k2.5
# LLM_ESTABLISH_FACTS_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
# LLM_RERANK_PROVERB_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
LLM_BACKEND=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=30
LLM_PROVIDER_RETRIES=2
LLM_MAX_CALLS_PER_RUN=300
LLM_DAILY_TOKEN_BUDGET=500000
LLM_INPUT_PRICE_PER_MILLION_USD=0
LLM_OUTPUT_PRICE_PER_MILLION_USD=0
